{
  "manifest_version": 3,
  "name": "物流网关 API 自动填写",
  "version": "0.3.15",
  "description": "解析网关 API 模板并自动填写重复字段。",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "http://gateway.jdl.com/*", "https://gateway.jdl.com/*",
    "http://uat-gateway.jdl.com/*", "https://uat-gateway.jdl.com/*"
  ],
  "action": {
    "default_title": "物流网关 API 自动填写",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://gateway.jdl.com/*", "https://gateway.jdl.com/*",
        "http://uat-gateway.jdl.com/*", "https://uat-gateway.jdl.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
